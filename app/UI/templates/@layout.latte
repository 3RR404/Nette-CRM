<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{ifset #title}{include #title} | {/ifset}Nette CRM</title>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
	<style>
		:root { --sidebar-width: 240px; }
		body { background: #f8f9fa; }
		.sidebar {
			width: var(--sidebar-width);
			min-height: 100vh;
			background: #1e2a3b;
			position: fixed;
			top: 0; left: 0;
			display: flex;
			flex-direction: column;
			z-index: 100;
		}
		.sidebar .brand {
			padding: 1.25rem 1.5rem;
			color: #fff;
			font-size: 1.2rem;
			font-weight: 700;
			border-bottom: 1px solid rgba(255,255,255,.1);
			text-decoration: none;
		}
		.sidebar .brand span { color: #4e9af1; }
		.sidebar nav { flex: 1; padding: .75rem 0; }
		.sidebar .nav-link {
			color: rgba(255,255,255,.7);
			padding: .55rem 1.5rem;
			border-radius: 0;
			display: flex;
			align-items: center;
			gap: .6rem;
			transition: all .15s;
		}
		.sidebar .nav-link:hover,
		.sidebar .nav-link.active {
			color: #fff;
			background: rgba(255,255,255,.08);
		}
		.sidebar .nav-link.active { border-left: 3px solid #4e9af1; }
		.sidebar .nav-section {
			font-size: .7rem;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: .08em;
			color: rgba(255,255,255,.35);
			padding: .9rem 1.5rem .25rem;
		}
		.sidebar-footer {
			padding: 1rem 1.5rem;
			border-top: 1px solid rgba(255,255,255,.1);
		}
		.main-content {
			margin-left: var(--sidebar-width);
			min-height: 100vh;
		}
		.topbar {
			background: #fff;
			border-bottom: 1px solid #dee2e6;
			padding: .65rem 1.5rem;
			display: flex;
			align-items: center;
			justify-content: space-between;
			position: sticky;
			top: 0;
			z-index: 50;
		}
		.page-content { padding: 1.5rem; }
		.stat-card {
			background: #fff;
			border-radius: .5rem;
			padding: 1.25rem 1.5rem;
			box-shadow: 0 1px 3px rgba(0,0,0,.06);
			border: 1px solid #e9ecef;
		}
		.stat-card .icon {
			width: 48px; height: 48px;
			border-radius: .5rem;
			display: flex; align-items: center; justify-content: center;
			font-size: 1.4rem;
		}
		.card { border: 1px solid #e9ecef; box-shadow: 0 1px 3px rgba(0,0,0,.06); }
		.badge-stage-new         { background: #6c757d; }
		.badge-stage-qualified   { background: #0d6efd; }
		.badge-stage-proposal    { background: #fd7e14; }
		.badge-stage-negotiation { background: #6f42c1; }
		.badge-stage-won         { background: #198754; }
		.badge-stage-lost        { background: #dc3545; }
		.pipeline-col { min-width: 240px; }
		.pipeline-card {
			background: #fff;
			border: 1px solid #e9ecef;
			border-radius: .4rem;
			padding: .75rem;
			margin-bottom: .5rem;
			cursor: grab;
		}
		.pipeline-col-header {
			font-weight: 600;
			font-size: .8rem;
			text-transform: uppercase;
			letter-spacing: .06em;
			padding: .5rem .25rem;
		}
		.flash-messages { position: fixed; top: 1rem; right: 1rem; z-index: 9999; min-width: 280px; }
		.priority-urgent { color: #dc3545; }
		.priority-high   { color: #fd7e14; }
		.priority-medium { color: #0d6efd; }
		.priority-low    { color: #6c757d; }
	</style>
	{block head}{/block}
</head>
<body>

<div class="sidebar">
	<a href="{link Dashboard:}" class="brand">Nette <span>CRM</span></a>
	<nav>
		<span class="nav-section">Main</span>
		<a href="{link Dashboard:}" class="nav-link{if $presenter->name === 'Dashboard'} active{/if}">
			<i class="bi bi-speedometer2"></i> Dashboard
		</a>

		<span class="nav-section">Sales</span>
		<a href="{link Contact:}" class="nav-link{if $presenter->name === 'Contact'} active{/if}">
			<i class="bi bi-people"></i> Contacts
		</a>
		<a href="{link Company:}" class="nav-link{if $presenter->name === 'Company'} active{/if}">
			<i class="bi bi-building"></i> Companies
		</a>
		<a href="{link Deal:pipeline}" class="nav-link{if $presenter->name === 'Deal'} active{/if}">
			<i class="bi bi-funnel"></i> Deals
		</a>

		<span class="nav-section">Work</span>
		<a href="{link Task:}" class="nav-link{if $presenter->name === 'Task'} active{/if}">
			<i class="bi bi-check2-square"></i> Tasks
		</a>

		<span class="nav-section">Analytics</span>
		<a href="{link Report:}" class="nav-link{if $presenter->name === 'Report'} active{/if}">
			<i class="bi bi-bar-chart"></i> Reports
		</a>

		{if $userRole === 'admin'}
		<span class="nav-section">Admin</span>
		<a href="{link User:}" class="nav-link{if $presenter->name === 'User'} active{/if}">
			<i class="bi bi-person-gear"></i> Users
		</a>
		{/if}
	</nav>
	<div class="sidebar-footer">
		<div class="d-flex align-items-center gap-2">
			<div class="rounded-circle bg-primary d-flex align-items-center justify-content-center text-white" style="width:32px;height:32px;font-size:.8rem;">
				{$user->getIdentity()->first_name|upper}{$user->getIdentity()->last_name|upper}
			</div>
			<div class="flex-grow-1 overflow-hidden">
				<div class="text-white small fw-semibold text-truncate">{$user->getIdentity()->full_name}</div>
				<div style="color:rgba(255,255,255,.5);font-size:.7rem">{$userRole}</div>
			</div>
			<a href="{link Sign:logout}" class="text-white-50" title="Logout"><i class="bi bi-box-arrow-right"></i></a>
		</div>
	</div>
</div>

<div class="main-content">
	<div class="topbar">
		<div>
			{block pageTitle}<span class="fw-semibold">Dashboard</span>{/block}
		</div>
		<div class="d-flex align-items-center gap-3">
			<a href="{link Contact:create}" class="btn btn-sm btn-primary" title="Add Contact"><i class="bi bi-person-plus"></i> Add Contact</a>
			<a href="{link Deal:create}" class="btn btn-sm btn-success" title="Add Deal"><i class="bi bi-plus-circle"></i> Add Deal</a>
		</div>
	</div>

	<div class="page-content">
		<div class="flash-messages">
			{foreach $flashes as $flash}
			<div class="alert alert-{$flash->type} alert-dismissible fade show" role="alert">
				{$flash->message}
				<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
			</div>
			{/foreach}
		</div>

		{block content}{/block}
	</div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{block scripts}{/block}
</body>
</html>
