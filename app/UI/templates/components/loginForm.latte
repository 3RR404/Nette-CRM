{foreach $form->getErrors() as $error}
<div class="alert alert-danger">{$error}</div>
{/foreach}

<form n:name="form" class="needs-validation" novalidate>
	<div class="mb-3">
		<label n:name="email" class="form-label fw-semibold">Email address</label>
		<input n:name="email" class="form-control form-control-lg">
		{inputError email}<div class="invalid-feedback d-block">{/inputError}
	</div>

	<div class="mb-3">
		<label n:name="password" class="form-label fw-semibold">Password</label>
		<input n:name="password" class="form-control form-control-lg">
		{inputError password}<div class="invalid-feedback d-block">{/inputError}
	</div>

	<div class="mb-4">
		<label class="d-flex align-items-center gap-2">
			<input n:name="remember" class="form-check-input"> Remember me
		</label>
	</div>

	<button n:name="send" class="btn btn-primary btn-lg w-100">Sign In</button>
</form>
