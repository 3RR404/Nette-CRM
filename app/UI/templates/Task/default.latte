{layout '../@layout.latte'}
{block pageTitle}Tasks{/block}

{block content}
<div class="d-flex justify-content-between align-items-center mb-4">
	<h4 class="fw-bold mb-0">Tasks <span class="badge bg-danger ms-1">{$openCount} open</span></h4>
	<a href="{link create}" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Add Task</a>
</div>

<div class="d-flex gap-2 mb-3">
	{foreach ['all' => 'All', 'mine' => 'My Tasks', 'today' => 'Due Today', 'overdue' => 'Overdue'] as $f => $label}
	<a href="{link default, filter => $f}"
	   class="btn btn-sm {if $filter === $f}btn-primary{else}btn-outline-secondary{/if}">
		{$label}
	</a>
	{/foreach}
</div>

<div class="card">
	<div class="table-responsive">
		<table class="table table-hover align-middle mb-0">
			<thead class="table-light">
				<tr>
					<th></th>
					<th>Title</th>
					<th>Type</th>
					<th>Priority</th>
					<th>Due Date</th>
					<th>Status</th>
					<th>Assigned To</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				{foreach $tasks as $task}
				<tr class="{if $task->status === 'completed'}table-success opacity-75{/if}">
					<td>
						{if $task->status !== 'completed'}
						<a href="{link complete, $task->id}" class="btn btn-sm btn-outline-success p-1 lh-1" title="Complete">
							<i class="bi bi-check-lg"></i>
						</a>
						{else}
						<i class="bi bi-check-circle-fill text-success"></i>
						{/if}
					</td>
					<td class="fw-semibold small">{$task->title}</td>
					<td><span class="badge bg-secondary">{ucfirst($task->type)}</span></td>
					<td>
						<span class="priority-{$task->priority}">
							<i class="bi bi-circle-fill" style="font-size:.5rem"></i> {ucfirst($task->priority)}
						</span>
					</td>
					<td class="small {if $task->due_date && $task->due_date < date('Y-m-d') && $task->status !== 'completed'}text-danger fw-semibold{else}text-muted{/if}">
						{$task->due_date|date:'d.m.Y'}
						{if $task->due_time} {$task->due_time|date:'H:i'}{/if}
					</td>
					<td><span class="badge bg-{$task->status === 'completed' ? 'success' : ($task->status === 'cancelled' ? 'secondary' : 'primary')}">{ucfirst(str_replace('_',' ',$task->status))}</span></td>
					<td class="small text-muted">{$task->assigned_to}</td>
					<td>
						<div class="d-flex gap-1">
							<a href="{link edit, $task->id}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
							<a href="{link delete, $task->id}" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete?')"><i class="bi bi-trash"></i></a>
						</div>
					</td>
				</tr>
				{else}
				<tr><td colspan="8" class="text-center text-muted py-5">No tasks found.</td></tr>
				{/foreach}
			</tbody>
		</table>
	</div>
</div>
{/block}
