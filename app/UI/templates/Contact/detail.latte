{layout '../@layout.latte'}
{block pageTitle}{$contact->first_name} {$contact->last_name}{/block}

{block content}
<div class="d-flex justify-content-between align-items-center mb-4">
	<div>
		<a href="{link default}" class="text-muted small"><i class="bi bi-arrow-left"></i> Contacts</a>
		<h4 class="fw-bold mb-0 mt-1">{$contact->first_name} {$contact->last_name}</h4>
		{if $contact->job_title}<p class="text-muted mb-0">{$contact->job_title}</p>{/if}
	</div>
	<div class="d-flex gap-2">
		<a href="{link edit, $contact->id}" class="btn btn-outline-secondary"><i class="bi bi-pencil"></i> Edit</a>
		<a href="{link delete, $contact->id}" class="btn btn-outline-danger" onclick="return confirm('Delete?')">
			<i class="bi bi-trash"></i> Delete
		</a>
	</div>
</div>

<div class="row g-3">
	{* Left column: info *}
	<div class="col-lg-4">
		<div class="card mb-3">
			<div class="card-header fw-semibold">Contact Info</div>
			<div class="list-group list-group-flush small">
				{if $contact->email}
				<div class="list-group-item d-flex gap-2">
					<i class="bi bi-envelope text-muted mt-1"></i>
					<div><div class="text-muted" style="font-size:.7rem">Email</div><a href="mailto:{$contact->email}">{$contact->email}</a></div>
				</div>
				{/if}
				{if $contact->phone}
				<div class="list-group-item d-flex gap-2">
					<i class="bi bi-telephone text-muted mt-1"></i>
					<div><div class="text-muted" style="font-size:.7rem">Phone</div>{$contact->phone}</div>
				</div>
				{/if}
				{if $contact->mobile}
				<div class="list-group-item d-flex gap-2">
					<i class="bi bi-phone text-muted mt-1"></i>
					<div><div class="text-muted" style="font-size:.7rem">Mobile</div>{$contact->mobile}</div>
				</div>
				{/if}
				{if $contact->company_id}
				<div class="list-group-item d-flex gap-2">
					<i class="bi bi-building text-muted mt-1"></i>
					<div>
						<div class="text-muted" style="font-size:.7rem">Company</div>
						<a href="{link Company:detail, $contact->company_id}">{$contact->ref('companies','company_id')->name}</a>
					</div>
				</div>
				{/if}
				<div class="list-group-item d-flex gap-2">
					<i class="bi bi-tag text-muted mt-1"></i>
					<div><div class="text-muted" style="font-size:.7rem">Status</div>
					<span class="badge bg-secondary">{ucfirst($contact->status)}</span></div>
				</div>
				{if $contact->source}
				<div class="list-group-item d-flex gap-2">
					<i class="bi bi-signpost text-muted mt-1"></i>
					<div><div class="text-muted" style="font-size:.7rem">Source</div>{ucfirst($contact->source)}</div>
				</div>
				{/if}
				{if $contact->city || $contact->country}
				<div class="list-group-item d-flex gap-2">
					<i class="bi bi-geo-alt text-muted mt-1"></i>
					<div><div class="text-muted" style="font-size:.7rem">Location</div>{$contact->city}{if $contact->city && $contact->country}, {/if}{$contact->country}</div>
				</div>
				{/if}
				<div class="list-group-item d-flex gap-2">
					<i class="bi bi-calendar text-muted mt-1"></i>
					<div><div class="text-muted" style="font-size:.7rem">Added</div>{$contact->created_at|date:'d.m.Y'}</div>
				</div>
			</div>
		</div>

		{if $tags}
		<div class="card mb-3">
			<div class="card-header fw-semibold">Tags</div>
			<div class="card-body">
				{foreach $tags as $tag}
				<span class="badge me-1 mb-1" style="background:{$tag->color}">{$tag->name}</span>
				{/foreach}
			</div>
		</div>
		{/if}
	</div>

	{* Right column: activity *}
	<div class="col-lg-8">
		{* Deals *}
		{if iterator_count($deals)}
		<div class="card mb-3">
			<div class="card-header d-flex justify-content-between">
				<span class="fw-semibold">Deals</span>
				<a href="{link Deal:create}" class="btn btn-sm btn-outline-primary">+ Add Deal</a>
			</div>
			<div class="list-group list-group-flush small">
				{foreach $deals as $deal}
				<a href="{link Deal:detail, $deal->id}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
					<span>{$deal->title}</span>
					<div class="d-flex align-items-center gap-2">
						{if $deal->value}<span class="text-muted">${number_format($deal->value, 0)}</span>{/if}
						<span class="badge badge-stage-{$deal->stage} text-white">{ucfirst($deal->stage)}</span>
					</div>
				</a>
				{/foreach}
			</div>
		</div>
		{/if}

		{* Tasks *}
		<div class="card mb-3">
			<div class="card-header d-flex justify-content-between">
				<span class="fw-semibold">Tasks</span>
				<a href="{link Task:create, relatedType => 'contact', relatedId => $contact->id}" class="btn btn-sm btn-outline-primary">+ Add Task</a>
			</div>
			{if iterator_count($tasks)}
			<div class="list-group list-group-flush small">
				{foreach $tasks as $task}
				<div class="list-group-item d-flex align-items-center gap-2">
					<i class="bi bi-{$task->type === 'call' ? 'telephone' : ($task->type === 'meeting' ? 'calendar-event' : 'check2-square')} text-muted"></i>
					<div class="flex-grow-1">{$task->title}</div>
					{if $task->due_date}<span class="text-muted">{$task->due_date|date:'d.m.'}</span>{/if}
					<span class="badge bg-{$task->status === 'completed' ? 'success' : 'secondary'}">{ucfirst($task->status)}</span>
				</div>
				{/foreach}
			</div>
			{else}
			<div class="card-body text-muted small">No tasks yet.</div>
			{/if}
		</div>

		{* Notes *}
		<div class="card mb-3" n:snippet="notes">
			<div class="card-header fw-semibold">Notes</div>
			<div class="list-group list-group-flush">
				{foreach $notes as $note}
				<div class="list-group-item small">
					<div class="text-muted mb-1" style="font-size:.72rem">{$note->created_at|date:'d.m.Y H:i'}</div>
					<div>{$note->content|nl2br}</div>
				</div>
				{else}
				<div class="list-group-item text-muted small">No notes yet.</div>
				{/foreach}
			</div>
			<div class="card-footer">
				<form n:name="addNoteForm" class="d-flex gap-2">
					<input type="hidden" name="contactId" value="{$contact->id}">
					<textarea name="content" class="form-control form-control-sm" rows="2" placeholder="Add a note..."></textarea>
					<button type="submit" class="btn btn-sm btn-primary">Add</button>
				</form>
			</div>
		</div>

		{* Activity log *}
		{if iterator_count($activity)}
		<div class="card">
			<div class="card-header fw-semibold">Activity Log</div>
			<div class="list-group list-group-flush small">
				{foreach $activity as $log}
				<div class="list-group-item d-flex gap-2 align-items-start">
					<i class="bi bi-clock text-muted mt-1"></i>
					<div class="flex-grow-1">{$log->description}</div>
					<span class="text-muted" style="font-size:.7rem">{$log->created_at|date:'d.m. H:i'}</span>
				</div>
				{/foreach}
			</div>
		</div>
		{/if}
	</div>
</div>
{/block}
