{layout '../@layout.latte'}
{block pageTitle}{$company->name}{/block}

{block content}
<div class="d-flex justify-content-between align-items-center mb-4">
	<div>
		<a href="{link default}" class="text-muted small"><i class="bi bi-arrow-left"></i> Companies</a>
		<h4 class="fw-bold mb-0 mt-1">{$company->name}</h4>
		{if $company->industry}<p class="text-muted mb-0 small">{$company->industry}</p>{/if}
	</div>
	<div class="d-flex gap-2">
		<a href="{link edit, $company->id}" class="btn btn-outline-secondary"><i class="bi bi-pencil"></i> Edit</a>
		<a href="{link delete, $company->id}" class="btn btn-outline-danger" onclick="return confirm('Delete?')"><i class="bi bi-trash"></i></a>
	</div>
</div>

<div class="row g-3">
	<div class="col-lg-4">
		<div class="card mb-3">
			<div class="card-header fw-semibold">Company Info</div>
			<div class="list-group list-group-flush small">
				{if $company->email}
				<div class="list-group-item d-flex gap-2">
					<i class="bi bi-envelope text-muted"></i>
					<a href="mailto:{$company->email}">{$company->email}</a>
				</div>
				{/if}
				{if $company->phone}
				<div class="list-group-item d-flex gap-2">
					<i class="bi bi-telephone text-muted"></i>{$company->phone}
				</div>
				{/if}
				{if $company->website}
				<div class="list-group-item d-flex gap-2">
					<i class="bi bi-globe text-muted"></i>
					<a href="{$company->website}" target="_blank">{$company->website}</a>
				</div>
				{/if}
				{if $company->employees}
				<div class="list-group-item d-flex justify-content-between">
					<span class="text-muted">Employees</span><span>{$company->employees}</span>
				</div>
				{/if}
				{if $company->city}
				<div class="list-group-item d-flex justify-content-between">
					<span class="text-muted">Location</span>
					<span>{$company->city}{if $company->country}, {$company->country}{/if}</span>
				</div>
				{/if}
			</div>
		</div>
	</div>

	<div class="col-lg-8">
		{* Contacts *}
		<div class="card mb-3">
			<div class="card-header d-flex justify-content-between">
				<span class="fw-semibold">Contacts ({iterator_count($contacts)})</span>
				<a href="{link Contact:create}" class="btn btn-sm btn-outline-primary">+ Add Contact</a>
			</div>
			<div class="list-group list-group-flush small">
				{foreach $contacts as $contact}
				<a href="{link Contact:detail, $contact->id}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
					<span class="fw-semibold">{$contact->first_name} {$contact->last_name}</span>
					<div class="d-flex gap-2">
						<span class="text-muted">{$contact->job_title}</span>
						<span class="badge bg-secondary">{ucfirst($contact->status)}</span>
					</div>
				</a>
				{else}
				<div class="list-group-item text-muted">No contacts linked.</div>
				{/foreach}
			</div>
		</div>

		{* Deals *}
		<div class="card mb-3">
			<div class="card-header d-flex justify-content-between">
				<span class="fw-semibold">Deals ({iterator_count($deals)})</span>
				<a href="{link Deal:create}" class="btn btn-sm btn-outline-primary">+ Add Deal</a>
			</div>
			<div class="list-group list-group-flush small">
				{foreach $deals as $deal}
				<a href="{link Deal:detail, $deal->id}" class="list-group-item list-group-item-action d-flex justify-content-between">
					<span>{$deal->title}</span>
					<div class="d-flex gap-2">
						{if $deal->value}<span class="text-success">${number_format($deal->value,0)}</span>{/if}
						<span class="badge badge-stage-{$deal->stage} text-white">{ucfirst($deal->stage)}</span>
					</div>
				</a>
				{else}
				<div class="list-group-item text-muted">No deals yet.</div>
				{/foreach}
			</div>
		</div>

		{* Notes *}
		<div class="card" n:snippet="notes">
			<div class="card-header fw-semibold">Notes</div>
			<div class="list-group list-group-flush small">
				{foreach $notes as $note}
				<div class="list-group-item">
					<div class="text-muted" style="font-size:.72rem">{$note->created_at|date:'d.m.Y H:i'}</div>
					<div class="mt-1">{$note->content|nl2br}</div>
				</div>
				{else}
				<div class="list-group-item text-muted">No notes yet.</div>
				{/foreach}
			</div>
			<div class="card-footer">
				<form n:name="addNoteForm" class="d-flex gap-2">
					<input type="hidden" name="companyId" value="{$company->id}">
					<textarea name="content" class="form-control form-control-sm" rows="2" placeholder="Add a note..."></textarea>
					<button type="submit" class="btn btn-sm btn-primary">Add</button>
				</form>
			</div>
		</div>
	</div>
</div>
{/block}
