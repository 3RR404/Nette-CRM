{layout '../@layout.latte'}
{block pageTitle}404 Not Found{/block}

{block content}
<div class="text-center py-5">
	<div class="display-1 text-muted">404</div>
	<h2>Page Not Found</h2>
	<p class="text-muted">{$message}</p>
	<a href="{link Dashboard:}" class="btn btn-primary">Back to Dashboard</a>
</div>
{/block}
