{layout '../@layout.latte'}
{block pageTitle}Deals{/block}

{block content}
<div class="d-flex justify-content-between align-items-center mb-4">
	<h4 class="fw-bold mb-0">Deals</h4>
	<div class="d-flex gap-2">
		<a href="{link pipeline}" class="btn btn-outline-secondary btn-sm"><i class="bi bi-kanban"></i> Pipeline</a>
		<a href="{link create}" class="btn btn-primary btn-sm"><i class="bi bi-plus-circle"></i> Add Deal</a>
	</div>
</div>

{* Stats *}
<div class="row g-2 mb-4">
	{foreach ['new','qualified','proposal','negotiation','won','lost'] as $stage}
	{var $s = $stats[$stage] ?? ['count'=>0,'value'=>0]}
	<div class="col-md-2">
		<div class="stat-card text-center">
			<span class="badge badge-stage-{$stage} text-white mb-1">{ucfirst($stage)}</span>
			<div class="fw-bold">{$s['count']}</div>
			<div class="small text-muted">${number_format($s['value'], 0)}</div>
		</div>
	</div>
	{/foreach}
</div>

<div class="card mb-3">
	<div class="card-body py-2">
		<form method="get" class="row g-2 align-items-center">
			<div class="col-md-5">
				<input type="text" name="q" value="{$q}" class="form-control" placeholder="Search deals...">
			</div>
			<div class="col-md-3">
				<select name="stage" class="form-select">
					<option value="">All stages</option>
					{foreach $stages as $s}
					<option value="{$s}" {if $stage === $s}selected{/if}>{ucfirst($s)}</option>
					{/foreach}
				</select>
			</div>
			<div class="col-auto">
				<button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
				<a href="{link default}" class="btn btn-outline-secondary ms-1">Reset</a>
			</div>
		</form>
	</div>
</div>

<div class="card">
	<div class="table-responsive">
		<table class="table table-hover align-middle mb-0">
			<thead class="table-light">
				<tr>
					<th>Title</th>
					<th>Stage</th>
					<th class="text-end">Value</th>
					<th>Close Date</th>
					<th>Owner</th>
					<th>Updated</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				{foreach $deals as $deal}
				<tr>
					<td><a href="{link detail, $deal->id}" class="fw-semibold text-decoration-none text-dark">{$deal->title}</a></td>
					<td><span class="badge badge-stage-{$deal->stage} text-white">{ucfirst($deal->stage)}</span></td>
					<td class="text-end">{if $deal->value}${number_format($deal->value,0)} {$deal->currency}{/if}</td>
					<td class="small text-muted">{$deal->expected_close_date|date:'d.m.Y'}</td>
					<td class="small text-muted">{$deal->owner_id}</td>
					<td class="small text-muted">{$deal->updated_at|date:'d.m.Y'}</td>
					<td>
						<div class="d-flex gap-1">
							<a href="{link edit, $deal->id}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
							<a href="{link delete, $deal->id}" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete?')"><i class="bi bi-trash"></i></a>
						</div>
					</td>
				</tr>
				{else}
				<tr><td colspan="7" class="text-center text-muted py-5">No deals found.</td></tr>
				{/foreach}
			</tbody>
		</table>
	</div>
</div>
{/block}
