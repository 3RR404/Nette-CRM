{layout '../@layout.latte'}
{block pageTitle}{$deal->title}{/block}

{block content}
<div class="d-flex justify-content-between align-items-center mb-4">
	<div>
		<a href="{link default}" class="text-muted small"><i class="bi bi-arrow-left"></i> Deals</a>
		<h4 class="fw-bold mb-0 mt-1">{$deal->title}</h4>
	</div>
	<div class="d-flex gap-2">
		<a href="{link edit, $deal->id}" class="btn btn-outline-secondary"><i class="bi bi-pencil"></i> Edit</a>
		<a href="{link delete, $deal->id}" class="btn btn-outline-danger" onclick="return confirm('Delete?')"><i class="bi bi-trash"></i></a>
	</div>
</div>

<div class="row g-3">
	<div class="col-lg-4">
		<div class="card mb-3">
			<div class="card-header fw-semibold">Deal Info</div>
			<div class="list-group list-group-flush small">
				<div class="list-group-item d-flex justify-content-between">
					<span class="text-muted">Stage</span>
					<span class="badge badge-stage-{$deal->stage} text-white">{ucfirst($deal->stage)}</span>
				</div>
				{if $deal->value}
				<div class="list-group-item d-flex justify-content-between">
					<span class="text-muted">Value</span>
					<span class="fw-semibold text-success">${number_format($deal->value, 0)} {$deal->currency}</span>
				</div>
				{/if}
				{if $deal->probability !== null}
				<div class="list-group-item d-flex justify-content-between">
					<span class="text-muted">Probability</span>
					<span>{$deal->probability}%</span>
				</div>
				{/if}
				{if $deal->expected_close_date}
				<div class="list-group-item d-flex justify-content-between">
					<span class="text-muted">Expected Close</span>
					<span>{$deal->expected_close_date|date:'d.m.Y'}</span>
				</div>
				{/if}
				<div class="list-group-item d-flex justify-content-between">
					<span class="text-muted">Created</span>
					<span>{$deal->created_at|date:'d.m.Y'}</span>
				</div>
			</div>
		</div>

		{* Stage mover *}
		<div class="card mb-3">
			<div class="card-header fw-semibold">Move Stage</div>
			<div class="card-body d-flex flex-wrap gap-1">
				{foreach $stages as $stage}
				{if $stage !== $deal->stage}
				<a href="{link handleMoveStage!, id => $deal->id, stage => $stage}"
				   class="btn btn-sm btn-outline-secondary">
					{ucfirst($stage)}
				</a>
				{/if}
				{/foreach}
			</div>
		</div>
	</div>

	<div class="col-lg-8">
		{* Tasks *}
		<div class="card mb-3">
			<div class="card-header d-flex justify-content-between">
				<span class="fw-semibold">Tasks</span>
				<a href="{link Task:create, relatedType => 'deal', relatedId => $deal->id}" class="btn btn-sm btn-outline-primary">+ Add</a>
			</div>
			{if iterator_count($tasks)}
			<div class="list-group list-group-flush small">
				{foreach $tasks as $task}
				<div class="list-group-item d-flex align-items-center gap-2">
					<i class="bi bi-check2-square text-muted"></i>
					<div class="flex-grow-1">{$task->title}</div>
					{if $task->due_date}<span class="text-muted small">{$task->due_date|date:'d.m.'}</span>{/if}
					<span class="badge bg-secondary">{ucfirst($task->status)}</span>
				</div>
				{/foreach}
			</div>
			{else}
			<div class="card-body text-muted small">No tasks yet.</div>
			{/if}
		</div>

		{* Notes *}
		<div class="card mb-3" n:snippet="notes">
			<div class="card-header fw-semibold">Notes</div>
			<div class="list-group list-group-flush small">
				{foreach $notes as $note}
				<div class="list-group-item">
					<div class="text-muted" style="font-size:.72rem">{$note->created_at|date:'d.m.Y H:i'}</div>
					<div class="mt-1">{$note->content|nl2br}</div>
				</div>
				{else}
				<div class="list-group-item text-muted">No notes yet.</div>
				{/foreach}
			</div>
			<div class="card-footer">
				<form n:name="addNoteForm" class="d-flex gap-2">
					<input type="hidden" name="dealId" value="{$deal->id}">
					<textarea name="content" class="form-control form-control-sm" rows="2" placeholder="Add a note..."></textarea>
					<button type="submit" class="btn btn-sm btn-primary">Add</button>
				</form>
			</div>
		</div>

		{* Activity *}
		{if iterator_count($activity)}
		<div class="card">
			<div class="card-header fw-semibold">Activity</div>
			<div class="list-group list-group-flush small">
				{foreach $activity as $log}
				<div class="list-group-item d-flex gap-2">
					<i class="bi bi-clock text-muted mt-1"></i>
					<div class="flex-grow-1">{$log->description}</div>
					<span class="text-muted" style="font-size:.7rem">{$log->created_at|date:'d.m. H:i'}</span>
				</div>
				{/foreach}
			</div>
		</div>
		{/if}
	</div>
</div>
{/block}
