{
    "name": "3rr404/nette-crm",
    "description": "A full-featured CRM built with Nette Framework",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "contributte/console": "^0.11.0",
        "doctrine/dbal": "^4.4",
        "doctrine/migrations": "^3.9",
        "latte/latte": "^3.0",
        "nette/application": "^3.2",
        "nette/bootstrap": "^3.2",
        "nette/database": "^3.2",
        "nette/di": "^3.2",
        "nette/forms": "^3.2",
        "nette/http": "^3.3",
        "nette/mail": "^4.0",
        "nette/security": "^3.2",
        "nette/utils": "^4.0",
        "symfony/console": "^8.0",
        "tracy/tracy": "^2.10",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "nette/tester": "^2.5",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
